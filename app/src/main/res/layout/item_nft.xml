<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/spacing_medium"
    >

  <com.google.android.material.imageview.ShapeableImageView
      android:id="@+id/nftImageView"
      android:layout_width="50dp"
      android:layout_height="50dp"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:shapeAppearanceOverlay="@style/RoundedImageView"
      tools:ignore="ContentDescription"
      tools:src="@drawable/ic_launcher_foreground"
      />

  <TextView
      android:id="@+id/nftNameTextView"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_small"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/tertiary_color"
      android:textStyle="bold"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/nftImageView"
      app:layout_constraintTop_toTopOf="@+id/nftImageView"
      tools:text="Bitcoin"
      />

  <TextView
      android:id="@+id/nftSymbolTextView"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_small"
      android:ellipsize="end"
      android:maxLines="1"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@+id/nftImageView"
      app:layout_constraintTop_toBottomOf="@+id/nftNameTextView"
      tools:text="BTC"
      />

</androidx.constraintlayout.widget.ConstraintLayout>